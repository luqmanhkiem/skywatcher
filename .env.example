# SkyWatcher environment template.
# Copy to .env for local development:  cp .env.example .env
# On Render, set these in the service's Environment tab (do NOT commit .env).

# ── MQTT broker ──────────────────────────────────────────────
# Local Mosquitto:
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=baggage/events
# HiveMQ Cloud (uncomment + fill for cloud):
# MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
# MQTT_PORT=8883
# MQTT_USER=your_hivemq_username
# MQTT_PASS=your_hivemq_password
# MQTT_USE_TLS=true

# ── Flask ────────────────────────────────────────────────────
FLASK_PORT=5001
FLASK_DEBUG=false
# PORT is injected automatically by Render; no need to set it.

# ── Anomaly detection ────────────────────────────────────────
ANOMALY_STALL_THRESHOLD_MINUTES=20

# ── Auth (JWT) ───────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=8

# ── Supabase (Project Settings > API) ────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# ── Email alerts (optional; leave blank to disable) ──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
