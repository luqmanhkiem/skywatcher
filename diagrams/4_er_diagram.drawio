          <mxGeometry x="1165" y="704" width="180" height="18" as="geometry"/>
        </mxCell>

        <!-- Legend keys -->
        <mxCell id="leg_pk" value="🔑 = Primary Key" style="text;html=1;fontSize=10;fontColor=#333;align=left;" vertex="1" parent="1">
          <mxGeometry x="1085" y="738" width="130" height="18" as="geometry"/>
