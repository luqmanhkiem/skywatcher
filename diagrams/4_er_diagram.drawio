        <!-- Legend: Zero or One -->
        <mxCell id="leg_zeroone_line" value="" style="endArrow=ERzeroToOne;endFill=0;startArrow=none;strokeColor=#555;strokeWidth=2;startSize=14;endSize=14;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
