<mxfile host="app.diagrams.net" modified="2026-04-16" agent="SkyWatcher" version="24.0.0" type="device">
  <diagram id="er-diagram" name="Entity-Relationship Diagram (Crow's Foot)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;SkyWatcher — Entity-Relationship Diagram (Crow's Foot Notation)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#1B3A5C;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="600" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== BAGS TABLE ========== -->
        <mxCell id="bags_header" value="&lt;b&gt;BAGS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A5C;strokeColor=#1B3A5C;fontColor=#FFFFFF;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="280" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="bags_body" value="&lt;div style=&quot;text-align:left;font-family:monospace;font-size:11px;line-height:1.8;padding:8px;&quot;&gt;🔑 &lt;b&gt;tag_id&lt;/b&gt; : TEXT &lt;i&gt;(PK)&lt;/i&gt;&lt;br&gt;    flight_id : TEXT&lt;br&gt;    passenger : TEXT&lt;br&gt;    status : TEXT &lt;i&gt;(in_transit / arrived)&lt;/i&gt;&lt;br&gt;    last_checkpoint : TEXT&lt;br&gt;    last_seen : TEXT&lt;br&gt;    created_at : TEXT&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A5C;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="80" y="135" width="280" height="195" as="geometry"/>
        </mxCell>

        <!-- ========== EVENTS TABLE ========== -->
        <mxCell id="events_header" value="&lt;b&gt;EVENTS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00695C;strokeColor=#00695C;fontColor=#FFFFFF;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="280" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="events_body" value="&lt;div style=&quot;text-align:left;font-family:monospace;font-size:11px;line-height:1.8;padding:8px;&quot;&gt;🔑 &lt;b&gt;id&lt;/b&gt; : INTEGER &lt;i&gt;(PK AUTO)&lt;/i&gt;&lt;br&gt;🔗 &lt;b&gt;tag_id&lt;/b&gt; : TEXT &lt;i&gt;(FK → bags)&lt;/i&gt;&lt;br&gt;    checkpoint : TEXT&lt;br&gt;    flight_id : TEXT&lt;br&gt;    timestamp : TEXT &lt;i&gt;(ISO 8601)&lt;/i&gt;&lt;br&gt;    duration_mins : REAL&lt;br&gt;    created_at : TEXT&lt;br&gt;&lt;br&gt;&lt;i style=&quot;color:#888;font-size:9px&quot;&gt;UNIQUE(tag_id, checkpoint, timestamp)&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00695C;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="560" y="135" width="280" height="225" as="geometry"/>
        </mxCell>

        <!-- ========== ANOMALIES TABLE ========== -->
        <mxCell id="anomalies_header" value="&lt;b&gt;ANOMALIES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B71C1C;strokeColor=#B71C1C;fontColor=#FFFFFF;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="460" width="280" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="anomalies_body" value="&lt;div style=&quot;text-align:left;font-family:monospace;font-size:11px;line-height:1.8;padding:8px;&quot;&gt;🔑 &lt;b&gt;id&lt;/b&gt; : INTEGER &lt;i&gt;(PK AUTO)&lt;/i&gt;&lt;br&gt;🔗 &lt;b&gt;tag_id&lt;/b&gt; : TEXT &lt;i&gt;(FK → bags)&lt;/i&gt;&lt;br&gt;    type : TEXT &lt;i&gt;(STALL / WRONG_ROUTE / ...)&lt;/i&gt;&lt;br&gt;    description : TEXT&lt;br&gt;    checkpoint : TEXT&lt;br&gt;    score : REAL &lt;i&gt;(0.0–1.0)&lt;/i&gt;&lt;br&gt;    resolved : INTEGER &lt;i&gt;(0/1)&lt;/i&gt;&lt;br&gt;    resolved_at : TEXT&lt;br&gt;    created_at : TEXT&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B71C1C;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="560" y="495" width="280" height="250" as="geometry"/>
        </mxCell>

        <!-- ========== USERS TABLE ========== -->
        <mxCell id="users_header" value="&lt;b&gt;USERS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4A148C;strokeColor=#4A148C;fontColor=#FFFFFF;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="1060" y="100" width="280" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="users_body" value="&lt;div style=&quot;text-align:left;font-family:monospace;font-size:11px;line-height:1.8;padding:8px;&quot;&gt;🔑 &lt;b&gt;id&lt;/b&gt; : INTEGER &lt;i&gt;(PK AUTO)&lt;/i&gt;&lt;br&gt;    username : TEXT &lt;i&gt;(UNIQUE)&lt;/i&gt;&lt;br&gt;    password_hash : TEXT&lt;br&gt;    role : TEXT &lt;i&gt;(admin/ground_staff/passenger)&lt;/i&gt;&lt;br&gt;    checkpoint : TEXT&lt;br&gt;    flight_id : TEXT&lt;br&gt;    tag_id : TEXT&lt;br&gt;    active : INTEGER &lt;i&gt;(1/0)&lt;/i&gt;&lt;br&gt;    created_at : TEXT&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A148C;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="1060" y="135" width="280" height="250" as="geometry"/>
        </mxCell>

        <!-- ========== CROW'S FOOT RELATIONSHIPS ========== -->

        <!-- BAGS ──||────────<  EVENTS  (One bag has many events, each event must belong to one bag) -->
        <mxCell id="rel1" value="" style="endArrow=ERmany;endFill=0;startArrow=ERmandOne;startFill=0;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1B3A5C;strokeWidth=2;startSize=14;endSize=14;" edge="1" source="bags_body" target="events_body" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel1_label" value="&lt;font style=&quot;font-size:10px;color:#1B3A5C;&quot;&gt;&lt;b&gt;has ▸&lt;/b&gt;&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="rel1">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- BAGS ──||───────o<  ANOMALIES  (One bag may trigger zero or many anomalies) -->
        <mxCell id="rel2" value="" style="endArrow=ERmany;endFill=0;startArrow=ERmandOne;startFill=0;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#B71C1C;strokeWidth=2;startSize=14;endSize=14;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="bags_body" target="anomalies_body" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="570"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rel2_label" value="&lt;font style=&quot;font-size:10px;color:#B71C1C;&quot;&gt;&lt;b&gt;may trigger ▸&lt;/b&gt;&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="rel2">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- USERS ─ ─ ─o||────── BAGS  (Optional: passenger user may be linked to a bag) -->
        <mxCell id="rel3" value="" style="endArrow=ERzeroToOne;endFill=0;startArrow=ERzeroToOne;startFill=0;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4A148C;strokeWidth=2;dashed=1;dashPattern=8 4;startSize=14;endSize=14;" edge="1" source="users_body" target="bags_body" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="420"/>
              <mxPoint x="700" y="420"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rel3_label" value="&lt;font style=&quot;font-size:10px;color:#4A148C;&quot;&gt;&lt;b&gt;◂ may track&lt;/b&gt;&lt;br&gt;&lt;i&gt;(passenger role only)&lt;/i&gt;&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="rel3">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <mxPoint y="-15" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- Note: USERS independent -->
        <mxCell id="users_note" value="&lt;font style=&quot;font-size:10px;color:#4A148C;&quot;&gt;&lt;i&gt;Independent entity.&lt;br&gt;Linked via role-based&lt;br&gt;access control (RBAC).&lt;br&gt;passenger role has optional&lt;br&gt;flight_id + tag_id fields.&lt;/i&gt;&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;size=14;align=left;fontSize=10;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="440" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="users_note_edge" style="strokeColor=#4A148C;dashed=1;strokeWidth=1;endArrow=none;" edge="1" source="users_body" target="users_note" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ========== CROW'S FOOT LEGEND ========== -->
        <mxCell id="legend_bg" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#CCCCCC;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="580" width="300" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="leg_title" value="&lt;b&gt;Crow's Foot Notation Legend&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1075" y="588" width="220" height="22" as="geometry"/>
        </mxCell>

        <!-- Legend: One (mandatory) -->
        <mxCell id="leg_one_line" value="" style="endArrow=ERmandOne;endFill=0;startArrow=none;strokeColor=#555;strokeWidth=2;startSize=14;endSize=14;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1085" y="630" as="sourcePoint"/>
            <mxPoint x="1155" y="630" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="leg_one_text" value="Exactly One (mandatory)" style="text;html=1;fontSize=10;fontColor=#333;align=left;" vertex="1" parent="1">
          <mxGeometry x="1165" y="620" width="180" height="18" as="geometry"/>
