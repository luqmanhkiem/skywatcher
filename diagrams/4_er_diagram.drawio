          <mxGeometry x="1165" y="648" width="180" height="18" as="geometry"/>
        </mxCell>

        <!-- Legend: Many (mandatory) -->
        <mxCell id="leg_many_line" value="" style="endArrow=ERmany;endFill=0;startArrow=none;strokeColor=#555;strokeWidth=2;startSize=14;endSize=14;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1085" y="686" as="sourcePoint"/>
            <mxPoint x="1155" y="686" as="targetPoint"/>
          </mxGeometry>
