          <mxGeometry x="1165" y="676" width="180" height="18" as="geometry"/>
        </mxCell>

        <!-- Legend: One to Many -->
        <mxCell id="leg_onetomany_line" value="" style="endArrow=ERmany;endFill=0;startArrow=ERmandOne;startFill=0;strokeColor=#555;strokeWidth=2;startSize=14;endSize=14;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1085" y="714" as="sourcePoint"/>
            <mxPoint x="1155" y="714" as="targetPoint"/>
