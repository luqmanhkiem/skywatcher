<mxfile host="app.diagrams.net" modified="2026-04-16" agent="SkyWatcher" version="24.0.0" type="device">
  <diagram id="anomaly-pipeline" name="Anomaly Detection Pipeline">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;SkyWatcher — Anomaly Detection Pipeline&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#1B3A5C;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="500" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== START ========== -->
        <mxCell id="start" value="&lt;b&gt;Incoming MQTT Event&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888;&quot;&gt;baggage/events topic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B3A5C;strokeColor=#F5A623;fontColor=#FFFFFF;fontSize=13;arcSize=12;shadow=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="240" height="55" as="geometry"/>
        </mxCell>

        <!-- Insert Event -->
        <mxCell id="insert" value="&lt;b&gt;Insert Event into DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555;&quot;&gt;insert_event(payload)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#4FC3F7;fontColor=#333;fontSize=11;arcSize=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="460" y="170" width="200" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e_start_insert" style="rounded=1;strokeColor=#888;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;" edge="1" source="start" target="insert" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ========== STEP 1: STALL CHECK ========== -->
        <mxCell id="stall_check" value="&lt;b&gt;Step 1: STALL Check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;duration_mins ≥ 20?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8EE;strokeColor=#F5A623;fontColor=#333;fontSize=11;shadow=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="445" y="260" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e_insert_stall" style="rounded=1;strokeColor=#888;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;" edge="1" source="insert" target="stall_check" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STALL Result -->
        <mxCell id="stall_result" value="&lt;b&gt;⚠️ STALL Anomaly&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Bag stalled at checkpoint&lt;br&gt;for &amp;gt; threshold minutes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#FF6B6B;fontColor=#FF6B6B;fontSize=11;arcSize=10;shadow=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="780" y="280" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_stall_yes" style="rounded=1;strokeColor=#FF6B6B;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;" edge="1" source="stall_check" target="stall_result" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="stall_yes_label" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#FF6B6B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="290" width="40" height="20" as="geometry"/>
        </mxCell>

        <!-- ========== STEP 2: WRONG_ROUTE CHECK ========== -->
        <mxCell id="route_check" value="&lt;b&gt;Step 2: WRONG_ROUTE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Skipped &amp;gt; 1 step&lt;br&gt;from previous?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8EE;strokeColor=#F5A623;fontColor=#333;fontSize=11;shadow=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="445" y="430" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e_stall_no" style="rounded=1;strokeColor=#00CC7D;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;" edge="1" source="stall_check" target="route_check" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="stall_no_label" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#00CC7D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="385" width="40" height="20" as="geometry"/>
        </mxCell>

        <!-- WRONG_ROUTE Result -->
        <mxCell id="route_result" value="&lt;b&gt;⚠️ WRONG_ROUTE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Bag jumped checkpoints&lt;br&gt;(e.g. check_in → loading)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#FF6B6B;fontColor=#FF6B6B;fontSize=11;arcSize=10;shadow=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="780" y="450" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_route_yes" style="rounded=1;strokeColor=#FF6B6B;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;" edge="1" source="route_check" target="route_result" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="route_yes_label" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#FF6B6B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="462" width="40" height="20" as="geometry"/>
        </mxCell>

        <!-- ========== STEP 3: SECURITY_BYPASS CHECK ========== -->
        <mxCell id="bypass_check" value="&lt;b&gt;Step 3: SECURITY_BYPASS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Past sorting without&lt;br&gt;security in history?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8EE;strokeColor=#F5A623;fontColor=#333;fontSize=11;shadow=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="435" y="600" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e_route_no" style="rounded=1;strokeColor=#00CC7D;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;" edge="1" source="route_check" target="bypass_check" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="route_no_label" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#00CC7D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="555" width="40" height="20" as="geometry"/>
        </mxCell>

        <!-- SECURITY_BYPASS Result -->
        <mxCell id="bypass_result" value="&lt;b&gt;⚠️ SECURITY_BYPASS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Security screening&lt;br&gt;missing from bag history&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#FF6B6B;fontColor=#FF6B6B;fontSize=11;arcSize=10;shadow=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="780" y="622" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_bypass_yes" style="rounded=1;strokeColor=#FF6B6B;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;" edge="1" source="bypass_check" target="bypass_result" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="bypass_yes_label" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#FF6B6B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="635" width="40" height="20" as="geometry"/>
        </mxCell>

        <!-- ========== STEP 4: ISOLATION FOREST ========== -->
        <mxCell id="if_check" value="&lt;b&gt;Step 4: Isolation Forest&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;ML confidence &amp;gt; 0.75?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E91E63;fontColor=#333;fontSize=11;shadow=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="445" y="770" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e_bypass_no" style="rounded=1;strokeColor=#00CC7D;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;" edge="1" source="bypass_check" target="if_check" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="bypass_no_label" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#00CC7D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="725" width="40" height="20" as="geometry"/>
        </mxCell>

        <!-- ML Anomaly Result -->
        <mxCell id="if_result" value="&lt;b&gt;⚠️ ANOMALY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;ML catch-all:&lt;br&gt;unusual movement pattern&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a2a10;strokeColor=#F5A623;fontColor=#F5A623;fontSize=11;arcSize=10;shadow=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="780" y="795" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_if_yes" style="rounded=1;strokeColor=#F5A623;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;" edge="1" source="if_check" target="if_result" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="if_yes_label" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#F5A623;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="808" width="40" height="20" as="geometry"/>
        </mxCell>

        <!-- ========== NORMAL (end) ========== -->
        <mxCell id="normal" value="&lt;b&gt;✅ Normal Event&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555;&quot;&gt;No anomaly detected&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d2618;strokeColor=#00CC7D;fontColor=#00CC7D;fontSize=12;arcSize=12;shadow=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="940" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_if_no" style="rounded=1;strokeColor=#00CC7D;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;" edge="1" source="if_check" target="normal" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="if_no_label" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#00CC7D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="900" width="40" height="20" as="geometry"/>
        </mxCell>

        <!-- ========== STORE ANOMALY (common endpoint for all anomaly results) ========== -->
        <mxCell id="store" value="&lt;b&gt;Store Anomaly&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#ddd;&quot;&gt;INSERT INTO anomalies&lt;br&gt;(tag_id, type, score, ...)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B3A5C;strokeColor=#FF6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=10;shadow=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1050" y="555" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e_s1_store" style="rounded=1;strokeColor=#FF6B6B;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=6;" edge="1" source="stall_result" target="store" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_s2_store" style="rounded=1;strokeColor=#FF6B6B;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=6;" edge="1" source="route_result" target="store" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_s3_store" style="rounded=1;strokeColor=#FF6B6B;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=6;" edge="1" source="bypass_result" target="store" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_s4_store" style="rounded=1;strokeColor=#F5A623;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=6;" edge="1" source="if_result" target="store" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ========== FEATURE VECTOR NOTE ========== -->
        <mxCell id="feature_note" value="&lt;div style=&quot;text-align:left;padding:6px;&quot;&gt;&lt;b&gt;Feature Vector (Isolation Forest)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:monospace;font-size:10px;&quot;&gt;[duration_mins,&lt;br&gt; checkpoint_index,&lt;br&gt; expected_next_index]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888;&quot;&gt;Confidence = clip(0.5 − raw_score, 0, 1)&lt;br&gt;n_estimators=100, contamination=0.05&lt;/font&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E91E63;size=14;align=left;fontSize=10;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="250" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="e_note_if" style="strokeColor=#E91E63;dashed=1;strokeWidth=1;endArrow=none;" edge="1" source="feature_note" target="if_check" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend_bg" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#CCCCCC;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ltitle" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="75" y="108" width="60" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="l1" value="" style="rhombus;fillColor=#FFF8EE;strokeColor=#F5A623;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="75" y="134" width="18" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="l1t" value="= Decision (rule check)" style="text;html=1;fontSize=10;fontColor=#333;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="132" width="140" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="" style="rounded=1;fillColor=#3a1010;strokeColor=#FF6B6B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="75" y="156" width="18" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="l2t" value="= Anomaly detected" style="text;html=1;fontSize=10;fontColor=#333;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="154" width="120" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="" style="rounded=1;fillColor=#0d2618;strokeColor=#00CC7D;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="75" y="178" width="18" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="l3t" value="= Normal (no anomaly)" style="text;html=1;fontSize=10;fontColor=#333;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="176" width="140" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="l4t2" value="&lt;font style=&quot;color:#FF6B6B&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt; = anomaly,  &lt;font style=&quot;color:#00CC7D&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/font&gt; = continue" style="text;html=1;fontSize=10;fontColor=#333;align=left;" vertex="1" parent="1">
          <mxGeometry x="75" y="196" width="220" height="18" as="geometry"/>
        </mxCell>

